# Copy to .env.local and fill in real values for production. Never commit
# .env.local — it is already covered by the default Vite .gitignore entry.

# WhatsApp click-to-chat number, international format, digits only (no "+").
# e.g. Costa Rica mobile: 506XXXXXXXX
VITE_WHATSAPP_PHONE=50600000000

# Web3Forms access key (https://web3forms.com) used by the contact form on
# the property detail page. Leave empty in dev; the form still renders and
# shows a friendly error on submit if this is unset.
VITE_WEB3FORMS_KEY=

# Contact email shown as a fallback contact path.
VITE_CONTACT_EMAIL=beyondrealtycr@outlook.com
